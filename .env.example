APP_NAME=سوالف
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=swalif
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Namecheap layout:
#   /home/USER/Swalif        = Laravel app
#   /home/USER/public_html   = contents of /public (images, build, index.php, storage)
# Uploads go to public_html/storage (NOT Swalif/storage/app/public)
# After upload:
#   1) Copy updated public/index.php → public_html/index.php
#   2) Copy public/fix-storage.php → public_html/fix-storage.php
#   3) Open https://your-domain.com/fix-storage.php?key=swalif-fix-2026 then DELETE it
#   4) APP_URL=https://your-real-domain.com
# Optional:
# PUBLIC_PATH=/home/USER/public_html
# PUBLIC_STORAGE_PATH=/home/USER/public_html/storage
# MEDIA_FIX_KEY=swalif-fix-2026
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
PUBLIC_PATH=
PUBLIC_STORAGE_PATH=
MEDIA_FIX_KEY=swalif-fix-2026

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# After deploy on the server, run:
# php artisan app:prepare-media
# php artisan migrate --force
# php artisan db:seed --force   (only for fresh install)
# npm run build
# Ensure PHP upload_max_filesize / post_max_size >= 64M for video uploads
