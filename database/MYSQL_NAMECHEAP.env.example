# ============================================================
# Namecheap / cPanel — MySQL (انسخ القيم من cPanel → MySQL Databases)
# ============================================================
# ملاحظة: اسم القاعدة والمستخدم غالباً بيبقى بالشكل:
#   username_swalif
#   username_swalifuser
# مش "swalif" لوحده.
# ============================================================

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=username_swalif
DB_USERNAME=username_swalifuser
DB_PASSWORD=ضع_كلمة_مرور_قوية

# بعد الرفع على السيرفر:
# 1) APP_URL=https://your-domain.com
# 2) APP_ENV=production
# 3) APP_DEBUG=false
# 4) افتح مرة واحدة فقط:
#    https://your-domain.com/setup-database.php?key=SwalifSetup2026
# 5) احذف الملف public/setup-database.php فوراً
# 6) php artisan app:prepare-media   (لو عندك Terminal)
#    أو التثبيت من اللينك فوق بيعملها تلقائي
